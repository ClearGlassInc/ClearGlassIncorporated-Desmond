{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearglassinc.github.io/schemas/company-orchestrator-tool-schema.json",
  "title": "ClearGlass Company Orchestrator Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "requested_by", "objective", "risk_level", "agents", "validation"],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "approval_required": {
      "type": "boolean",
      "default": false
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "intake",
          "planner",
          "executor",
          "auditor",
          "logger",
          "deployment",
          "marketing",
          "revenue",
          "compliance",
          "monitoring"
        ]
      },
      "uniqueItems": true
    },
    "target_files": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "validate-site",
          "check-links",
          "audit-assets",
          "workflow-doctor",
          "site-reliability-audit",
          "pytest",
          "ruff",
          "manual-review"
        ]
      },
      "uniqueItems": true
    },
    "rollback": {
      "type": "string",
      "default": "Revert the patch commit or PR merge commit, then re-run Deploy GitHub Pages."
    }
  }
}
