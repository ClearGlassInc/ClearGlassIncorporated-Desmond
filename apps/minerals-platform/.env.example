# Runtime
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
PUBLIC_MINERALS_BASE_URL=https://www.clearglassinc.com
INGESTION_CONCURRENCY=4

# PostgreSQL / PostGIS
DATABASE_URL=postgresql://minerals:minerals@localhost:5432/minerals?schema=public
DIRECT_URL=postgresql://minerals:minerals@localhost:5432/minerals?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Authentication / SSO-ready boundary
AUTH_MODE=development
IDENTITY_GATEWAY_SECRET=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SAML_ENTRYPOINT=
SAML_ISSUER=
SAML_CERT=
MFA_REQUIRED=true

# Optional provider credentials. Never expose these with NEXT_PUBLIC_.
USGS_API_KEY=
TRADE_API_KEY=
MARKET_DATA_API_KEY=
NEWS_API_KEY=
SATELLITE_API_KEY=
INGESTION_WEBHOOK_SECRET=

# Alerts / integrations
SMTP_URL=
ALERT_EMAIL_FROM=alerts@clearglassinc.com
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SIGNING_SECRET=
DIGEST_EMAIL_TO=
DIGEST_DAILY_CRON=0 0 12 * * *
DIGEST_WEEKLY_CRON=0 5 12 * * 1

# AI analyst integration. Server-side only.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Security
EXPORT_SIGNING_SECRET=
AUDIT_HASH_SECRET=
UPLOAD_MAX_BYTES=10485760
