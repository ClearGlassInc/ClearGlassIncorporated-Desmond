# ClearGlass Commerce — configuration template. Copy to .env and fill in.
# NEVER commit a real .env. All values below are placeholders.

# ── control plane ────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=clearglass-commerce
LOG_LEVEL=info

# ── database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5432/commerce

# ── governance ───────────────────────────────────────────────────────────────
# Hard gate: when true, high/critical actions can NEVER auto-execute (recommended).
REQUIRE_APPROVAL_FOR_HIGH_RISK=true
# Low-stock threshold that triggers an escalation.
INVENTORY_LOW_THRESHOLD=10

# ── payments (Stripe) — fill from your dashboard, keep out of git ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── storefront / admin ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
STOREFRONT_PORT=3000
ADMIN_PORT=3001

# ── notifications (optional, for escalations) ────────────────────────────────
ESCALATION_EMAIL=info@clearglassinc.com
SLACK_WEBHOOK_URL=
