# ClearGlass Commerce — configuration template. Copy to .env and fill in.
# NEVER commit a real .env. All values below are placeholders.

# ── control plane ────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=clearglass-commerce
LOG_LEVEL=info

# ── database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5432/commerce

# ── governance ───────────────────────────────────────────────────────────────
# Hard gate: when true, high/critical actions can NEVER auto-execute (recommended).
REQUIRE_APPROVAL_FOR_HIGH_RISK=true
# Low-stock threshold that triggers an escalation.
INVENTORY_LOW_THRESHOLD=10

# ── admin authentication ─────────────────────────────────────────────────────
# Bearer token(s) required to call mutating admin endpoints (approvals, pricing,
# refunds, catalog writes). Comma-separated to rotate keys with no downtime.
# Empty = OPEN dev/mock mode. REQUIRED in production: with APP_ENV=production and
# no key set, the control plane fails closed and refuses to start.
# Callers send:  Authorization: Bearer <key>
ADMIN_API_KEY=

# Per-client-IP request throttles (per minute); 0 disables one.
RATE_LIMIT_CHECKOUT_PER_MINUTE=30
RATE_LIMIT_WEBHOOK_PER_MINUTE=240
RATE_LIMIT_DECISIONS_PER_MINUTE=60

# ── payments (Stripe) — fill from your dashboard, keep out of git ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Where Stripe Checkout redirects after pay/cancel.
CHECKOUT_SUCCESS_URL=http://localhost:3000/success
CHECKOUT_CANCEL_URL=http://localhost:3000/cancel

# Payout destination metadata (masked only). Configure the real external bank account
# in Stripe using dashboard/API secrets; never commit account, routing, transit, or card numbers.
PAYOUT_EXTERNAL_ACCOUNT_ID=ba_replace_with_stripe_external_account_token
PAYOUT_BANK_NAME=EQ Bank
PAYOUT_BANK_LAST4=1234
PAYOUT_BANK_ROUTING_HINT=primary-settlement-account
PAYOUT_BANK_COUNTRY=CA
PAYOUT_BANK_CURRENCIES=CAD,USD

# ── storefront / admin ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
STOREFRONT_PORT=3000
ADMIN_PORT=3001

# ── notifications (optional, for escalations) ────────────────────────────────
ESCALATION_EMAIL=info@clearglassinc.com
SLACK_WEBHOOK_URL=

# ── Etsy shop connection (see ETSY_CONNECT.md) ───────────────────────────────
# The keystring/secret come from https://www.etsy.com/developers/your-apps.
# The tokens are minted by `python -m app.etsy_connect` — never commit real ones.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=https://www.clearglassinc.com/etsy/callback
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_SCOPES=listings_r,listings_w,transactions_r,transactions_w
# Declared identity, cross-checked on verify (informational).
ETSY_PROFILE_URL=https://www.etsy.com/people/7is7jsngx568dcve
ETSY_SHOP_ID=
ETSY_SHOP_NAME=
ETSY_LOGIN_EMAIL=
