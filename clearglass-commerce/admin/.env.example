# Admin cockpit — route-protection configuration.
# Copy to .env.local for development; set these as environment variables in prod.

# REQUIRED IN PRODUCTION. Secret used to sign session cookies (HMAC-SHA256).
# Must be >= 16 chars; the login route fails closed if it is weak/unset in prod.
# Generate: openssl rand -hex 32
AUTH_SECRET=

# REQUIRED IN PRODUCTION. Password operators type on the /login page.
ADMIN_DASHBOARD_PASSWORD=

# Optional. Separate secret for signing download links. Falls back to AUTH_SECRET.
ASSET_SIGNING_SECRET=

# Optional. Salt for hashing request fingerprints in access logs.
LOG_SALT=

# Optional. Requests/min/fingerprint before an access log line is flagged "warn".
BURST_THRESHOLD=120

# Optional. Absolute site URL used to resolve canonical tags. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://admin.clearglass.example

# Marks the deployment as production: enables Secure cookies and fail-closed auth.
APP_ENV=production

# Control-plane base (already used by the cockpit's data client).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Enable only after the admin hostname is proxied and the Cloudflare late
# transform overwrites this header. Accept current,previous during rotation.
# Production rollout should set REQUIRED=true and use 32+ character secrets.
EDGE_ORIGIN_AUTH_REQUIRED=false
EDGE_ORIGIN_AUTH_HEADER_NAME=X-ClearGlass-Edge-Origin
EDGE_ORIGIN_AUTH_SECRETS=
