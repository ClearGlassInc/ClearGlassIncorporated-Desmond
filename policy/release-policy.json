{
  "schema_version": "1.0",
  "change_reference": {"format": "^(CHG|RFC|INC|SEC)-[0-9]{4,}$"},
  "authorized_refs": ["main", "signed_release_tag"],
  "signed_release_tag": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$",
  "requirements": {
    "production": ["validation_passed", "immutable_artifact_digest", "change_reference", "circle_approval", "production_context", "post_deploy_verification"],
    "production_rollback": ["verified_prior_artifact", "change_reference", "separate_circle_approval", "production_context", "post_rollback_verification"]
  },
  "deployment_contexts": {"readonly": "ci-readonly", "staging": "staging-deploy", "production": "production-deploy"}
}
