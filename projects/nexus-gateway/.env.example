# Entra ID / OBO validation. Production fails closed if these are not configured.
NEXUS_ENTRA_TENANT_ID=
NEXUS_ENTRA_AUDIENCE=
NEXUS_REQUIRED_ROLE=Nexus.Operator
NEXUS_REQUIRED_SCOPE=nexus.execute

# Development only. Never enable on an internet-facing deployment.
NEXUS_DEV_AUTH_ENABLED=false

# Deterministic AI capability policy.
NEXUS_ALLOWED_TOOLS=network_optimizer,telemetry_parser,aegis_scan
NEXUS_MAX_PAYLOAD_BYTES=65536

# Optional Windows AEGIS dispatch. Disabled by default.
NEXUS_AEGIS_EXECUTION_ENABLED=false
NEXUS_AEGIS_SCRIPT_PATH=
NEXUS_AEGIS_POWERSHELL_EXECUTABLE=pwsh
NEXUS_AEGIS_TIMEOUT_SECONDS=900
