#!/usr/bin/env python3
"""Check ClearGlass static-site local links.

This script is intentionally stdlib-only so it can run in GitHub Actions without
extra dependencies. It validates local href/src references across HTML files and
fails on missing targets or path traversal outside the repository.
"""

from __future__ import annotations

from dataclasses import dataclass
from html.parser import HTMLParser
from pathlib import Path
import sys

REPO_ROOT = Path(__file__).resolve().parents[1]
SKIP_DIRS = {".git", "node_modules", ".next", "dist", "build", ".venv", "venv"}
LOCAL_SKIP_PREFIXES = (
    "http://",
    "https://",
    "//",
    "mailto:",
    "tel:",
    "#",
    "javascript:",
    "data:",
    "sms:",
)


@dataclass(frozen=True)
class Reference:
    file: Path
    line: int
    value: str


class RefParser(HTMLParser):
    def __init__(self, file: Path) -> None:
        super().__init__()
        self.file = file
        self.refs: list[Reference] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        attr_map = dict(attrs)
        for attr in ("href", "src"):
            value = attr_map.get(attr)
            if value:
                self.refs.append(Reference(self.file, self.getpos()[0], value.strip()))


def html_files() -> list[Path]:
    files: list[Path] = []
    for path in REPO_ROOT.rglob("*.html"):
        if any(part in SKIP_DIRS for part in path.parts):
            continue
        files.append(path)
    return sorted(files)


def is_local_ref(ref: str) -> bool:
    return bool(ref) and not ref.startswith(LOCAL_SKIP_PREFIXES)


def resolve_target(source: Path, ref: str) -> Path | None:
    clean = ref.split("#", 1)[0].split("?", 1)[0]
    if not clean:
        return None
    if clean.startswith("/"):
        return (REPO_ROOT / clean.lstrip("/")).resolve()
    return (source.parent / clean).resolve()


def main() -> int:
    errors: list[str] = []
    refs_checked = 0

    for file in html_files():
        parser = RefParser(file)
        parser.feed(file.read_text(encoding="utf-8", errors="ignore"))
        for ref in parser.refs:
            if not is_local_ref(ref.value):
                continue
            refs_checked += 1
            target = resolve_target(ref.file, ref.value)
            if target is None:
                continue
            try:
                target.relative_to(REPO_ROOT.resolve())
            except ValueError:
                errors.append(
                    f"{ref.file.relative_to(REPO_ROOT)}:{ref.line} escapes repository -> {ref.value}"
                )
                continue
            if not target.exists():
                errors.append(
                    f"{ref.file.relative_to(REPO_ROOT)}:{ref.line} missing local target -> {ref.value}"
                )

    print("== ClearGlass Local Link Check ==")
    print(f"HTML files scanned: {len(html_files())}")
    print(f"Local references checked: {refs_checked}")
    print(f"Errors: {len(errors)}")
    for error in errors:
        print(f"ERROR: {error}")

    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
