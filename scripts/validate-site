#!/usr/bin/env python3
"""Validate required ClearGlass company-orchestrator files.

This script is intentionally narrow and deterministic. CI runs the deeper audits
explicitly after this check: site reliability, local links, assets, and workflow
lint.
"""

from __future__ import annotations

import json
from pathlib import Path
import sys

REPO_ROOT = Path(__file__).resolve().parents[1]

REQUIRED_FILES = [
    "README.md",
    "index.html",
    ".github/workflows/pages.yml",
    ".github/workflows/ci.yml",
    ".github/workflows/security.yml",
    "docs/DEPLOYMENT.md",
    "docs/deployment.md",
    "docs/agents.md",
    "docs/secrets.md",
    "docs/rollback.md",
    "scripts/check-links",
    "scripts/audit-assets",
    "agents/company_orchestrator/agent.json",
    "agents/company_orchestrator/system_prompt.md",
    "agents/company_orchestrator/tool_schema.json",
]

REQUIRED_AGENT_IDS = {
    "intake",
    "planner",
    "executor",
    "auditor",
    "logger",
    "deployment",
    "marketing",
    "revenue",
    "compliance",
    "monitoring",
}


def load_json(path: Path) -> tuple[dict, str | None]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        return {}, f"{path.relative_to(REPO_ROOT)} is invalid JSON: {exc}"
    if not isinstance(data, dict):
        return {}, f"{path.relative_to(REPO_ROOT)} root must be a JSON object"
    return data, None


def main() -> int:
    errors: list[str] = []

    for rel_path in REQUIRED_FILES:
        if not (REPO_ROOT / rel_path).exists():
            errors.append(f"Missing required file: {rel_path}")

    manifest_path = REPO_ROOT / "agents/company_orchestrator/agent.json"
    schema_path = REPO_ROOT / "agents/company_orchestrator/tool_schema.json"

    if manifest_path.exists():
        manifest, error = load_json(manifest_path)
        if error:
            errors.append(error)
        else:
            present = {
                agent.get("id")
                for agent in manifest.get("agents", [])
                if isinstance(agent, dict)
            }
            missing = sorted(REQUIRED_AGENT_IDS - present)
            if missing:
                errors.append("company orchestrator manifest missing agents: " + ", ".join(missing))
            if manifest.get("runtime_model") != "static-compatible":
                errors.append("company orchestrator runtime_model must be static-compatible")

    if schema_path.exists():
        _, error = load_json(schema_path)
        if error:
            errors.append(error)

    print("== ClearGlass Company Validation ==")
    print(f"Repository: {REPO_ROOT}")
    print(f"Required files checked: {len(REQUIRED_FILES)}")
    print(f"Errors: {len(errors)}")

    for error in errors:
        print(f"ERROR: {error}")

    if not errors:
        print("Company-orchestrator manifest and required files are present.")

    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
